APP_NAME="Nalabumi AI"
APP_ENV=production
APP_KEY=base64:qchhEHxF2qPUHR3Zgvv+/mmONEQganc8z6NCV24ScEo=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=nalabumi
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@nalabumi.id"
MAIL_FROM_NAME="${APP_NAME}"

# Qdrant Vector DB
QDRANT_HOST=http://qdrant:6333
QDRANT_COLLECTION=articles

# AI Configuration (LLM)
OPENCODE_API_URL=https://api.groq.com/openai/v1/chat/completions
OPENCODE_API_KEY=your_groq_api_key_here
OPENCODE_MODEL=openai/gpt-oss-120b

# Embedding Configuration (Ollama)
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_URL=http://ollama:11434/api/embed
EMBEDDING_API_KEY=

